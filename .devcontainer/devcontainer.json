{
    "name": "QKD-MACsec-RADIUS (Containerlab DinD)",
    "image": "ghcr.io/srl-labs/containerlab/devcontainer-dind-slim:0.77.0",

    "features": {
        "ghcr.io/devcontainers-extra/features/ansible:2": {
            "version": "latest",
            "injections": "requests"
        },
        "ghcr.io/hspaans/devcontainer-features/ansible-lint:2": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:2.0.0": {}
    },

    "remoteUser": "root",
    "containerUser": "root",

    "containerEnv": {
        "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible.cfg"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "ms-azuretools.vscode-docker",
                "srl-labs.vscode-containerlab"
            ],
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "zsh": { "path": "/usr/bin/zsh" }
                },
                "terminal.integrated.defaultProfile.linux": "zsh"
            }
        }
    },
    "forwardPorts": [8080, 12345],

    "postCreateCommand": "pip install -r requirements-dev.txt"
}
