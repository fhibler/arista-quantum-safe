# Copy to .env (gitignored). All make targets load this file automatically (-include .env).
# Command-line overrides still win, e.g. make gen-topo CEOS_IMAGE=ceos:4.36.2F

# Arista portal API token — required for `make download-ceos`
# Create at https://www.arista.com/en/users/profile
ARISTA_TOKEN=

# Makefile overrides (optional; names match `Makefile` `?=` variables)

# cEOS-lab Docker image tag (default: ceos:4.36.2F)
# CEOS_IMAGE=ceos:4.36.2F

# Containerlab mgmt bridge subnet (default: 172.20.127.0/24)
# MGMT_SUBNET=172.20.127.0/24

# QuaDRA extension .swix for gen-topo / install-quadra (default: auto under download/quadra/)
# QUADRA_SWIX=/path/to/QuaDRA-1.0.10.rel1-aarch64.swix

# cEOS tarball directory (default: download)
# CEOS_DOWNLOAD_DIR=download

# Verbose build/deploy/test output (default: unset). Set to 1 for plain Docker logs and debug containerlab.
# VERBOSE=1
