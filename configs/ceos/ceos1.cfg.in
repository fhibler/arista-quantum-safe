hostname ceos1
username admin privilege 15 secret admin
!
service routing protocols model multi-agent
!
vrf instance MGMT
!
! Default gateway for custom mgmt subnet (Containerlab bridge).
ip route vrf MGMT 0.0.0.0/0 ${MGMT_GATEWAY}
!
interface Management0
   vrf MGMT
   ip address ${MGMT_IP_CEOS1}/${MGMT_PREFIX}
!
interface Ethernet1
   no switchport
   ip address 10.255.0.1/30
!
interface Ethernet2
   no switchport
   ip address 10.0.1.254/24
!
ip route 10.0.2.0/24 10.255.0.2
!
management api gnmi
   transport grpc default
      vrf MGMT
!
management api netconf
   transport ssh default
      vrf MGMT
!
management api http-commands
   no shutdown
   !
   vrf MGMT
      no shutdown
!
radius-server host ${RADIUS_SERVER_IP} vrf MGMT key testing123
!
aaa group server radius RADIUS
   server ${RADIUS_SERVER_IP} vrf MGMT
!
end
