hostname ceos3-qkd
no aaa root
!
logging console informational
logging vrf MGMT host ${SYSLOG_SERVER_IP} 6514 protocol tls ssl-profile SYSLOG
logging trap informational
!
aaa authentication policy local allow-nopassword-remote-login
aaa authorization exec default local
username admin nopassword role network-admin privilege 15
!
service routing protocols model multi-agent
!
vrf instance MGMT
!
! Default gateway for custom mgmt subnet (Containerlab bridge).
ip route vrf MGMT 0.0.0.0/0 ${MGMT_GATEWAY}
ipv6 route vrf MGMT ::/0 ${MGMT_IPV6_GATEWAY}
!
interface Management0
   vrf MGMT
   ip address ${MGMT_IP_CEOS3_QKD}/${MGMT_PREFIX}
   ipv6 address ${MGMT_IPV6_CEOS3_QKD}/${MGMT_IPV6_PREFIX}
!
interface Ethernet1
   no switchport
   ip address 10.255.0.6/30
   ipv6 address 2001:db8:255:0::6/126
   mac security profile quadra-slave
!
interface Ethernet8
   no switchport
   ip address 10.0.3.254/24
   ipv6 address 2001:db8:3::fe/64
!
ip routing
ipv6 unicast-routing
!
ip route 10.0.1.0/24 10.255.0.5
ip route 10.0.2.0/24 10.255.0.5
ipv6 route 2001:db8:1::/64 2001:db8:255:0::5
ipv6 route 2001:db8:2::/64 2001:db8:255:0::5
!
management api gnmi
   transport grpc default
      vrf MGMT
      ssl profile GNMI
!
management api restconf
   transport https restconf
      ssl profile RESTCONF
   vrf MGMT
!
management api eos-sdk-rpc
   transport grpc default
      local interface Management0
      service all
      no disabled
      ssl profile GNMI
!
management api netconf
   transport ssh default
      vrf MGMT
!
management api http-commands
   no shutdown
   protocol https ssl profile EAPI
   !
   vrf MGMT
      no shutdown
!
management ssh
   key-exchange mlkem768x25519-sha256
   cipher aes256-gcm@openssh.com aes128-gcm@openssh.com chacha20-poly1305@openssh.com
   mac hmac-sha2-256 hmac-sha2-512
   shutdown
   !
   vrf MGMT
      no shutdown
      !
!
! RadSec/eAPI/gNMI/RESTCONF PKI is installed post-boot via containerlab exec (copy is exec-only, not startup-config).
management security
   ssl profile EAPI
      tls versions 1.3
      key-establishment-group X25519MLKEM768
      cipher v1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
      certificate ceos3-qkd-eapi.pem key ceos3-qkd-eapi.key
   !
   ssl profile GNMI
      tls versions 1.3
      key-establishment-group X25519MLKEM768
      cipher v1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
      certificate ceos3-qkd-gnmi.pem key ceos3-qkd-gnmi.key
      trust certificate radsec-ca.pem
   !
   ssl profile RESTCONF
      tls versions 1.3
      key-establishment-group X25519MLKEM768
      cipher v1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
      certificate ceos3-qkd-gnmi.pem key ceos3-qkd-gnmi.key
      trust certificate radsec-ca.pem
   !
   ssl profile RADSEC
      tls versions 1.3
      key-establishment-group X25519MLKEM768
      cipher v1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
      certificate ceos3-qkd-client.pem key ceos3-qkd-client.key
      trust certificate radsec-ca.pem
   !
   ssl profile SYSLOG
      tls versions 1.3
      key-establishment-group X25519MLKEM768
      cipher v1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
      certificate ceos3-qkd-client.pem key ceos3-qkd-client.key
      trust certificate radsec-ca.pem
!
radius-server host ${RADIUS_SERVER_IP} vrf MGMT tls ssl-profile RADSEC
!
aaa group server radius RADIUS
   server ${RADIUS_SERVER_IP} tls vrf MGMT
!
${QUADRA_MACSEC_SLAVE}
!
${QUADRA_DAEMON_SLAVE}
!
${CONTROL_PLANE_ACL}
end
