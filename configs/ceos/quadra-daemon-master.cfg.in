! QuaDRA agent — master on ceos1-both (daemon left shutdown; install extension separately).
! Note: peer-mode CLI value is inverted — "slave" selects the master role (see docs/quadra.md).
daemon quadra
   exec /usr/bin/quadra
   shutdown
   option macsec-intf value ${QUADRA_MACSEC_INTF}
   option peer value ${QUADRA_PEER_IP}
   option peer-mode value slave
   option kme value ${MGMT_IP_KME_A}:${KME_A_PORT}
   option kme-vrf value MGMT
   option cacert value /mnt/flash/kme-ca.crt.pem
   option cert value /mnt/flash/kme-sae-bundle.pem
   option peer-sae value ${KME_B_SAE_ID}
   option recovery-keys value ${QUADRA_KEY_RX},${QUADRA_KEY_TX}
