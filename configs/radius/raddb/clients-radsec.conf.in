# RadSec NAS clients (TLS, port 2083). Rendered to lab/.gen/clients-radsec.conf.

client ceos1-both {
    ipaddr  = ${MGMT_IP_CEOS1_BOTH}
    proto   = tls
    secret  = radsec
    nas_type = other
    require_message_authenticator = true
    limit_proxy_state = true
}

client ceos2-pqc {
    ipaddr  = ${MGMT_IP_CEOS2_PQC}
    proto   = tls
    secret  = radsec
    nas_type = other
    require_message_authenticator = true
    limit_proxy_state = true
}

client ceos3-qkd {
    ipaddr  = ${MGMT_IP_CEOS3_QKD}
    proto   = tls
    secret  = radsec
    nas_type = other
    require_message_authenticator = true
    limit_proxy_state = true
}
