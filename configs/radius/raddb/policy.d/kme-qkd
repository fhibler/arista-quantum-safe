# ETSI QKD 014: after successful EAP-TLS, fetch a key from kme-a (fail-open).
# key_ID is logged by kme-fetch-key; raw key material is never stored in RADIUS.
kme-qkd {
	if (&reply:EAP-Session-Id) {
		update control {
			&Tmp-String-0 := `/usr/local/bin/kme-fetch-key`
		}
		if (&control:Tmp-String-0) {
			update reply {
				&Class += "QKD-Key-ID:%{control:Tmp-String-0}"
			}
		}
	}
}
