# Dynamic MACsec (802.1X-2020): the authenticator derives CAK/CKN from the EAP MSK
# and EAP-Key-Name. FreeRADIUS stores the session id in EAP-Session-Id; copy it to
# EAP-Key-Name on Access-Accept (see stock sites-available/default post-auth comments).
# Session-Timeout + Termination-Action drive periodic reauth on the EOS authenticator
# (matches ceos1 dot1x timeout reauth-period 60).
macsec-dot1x {
	if (&reply:EAP-Session-Id) {
		update reply {
			EAP-Key-Name := &reply:EAP-Session-Id
			Session-Timeout := 60
			Termination-Action := RADIUS-Request
		}
	}
}
