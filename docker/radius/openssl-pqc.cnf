# OpenSSL 3.5 TLS defaults for EOS PQC-hybrid RadSec (quantum-safe-radius:latest).
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
Groups = X25519MLKEM768:secp256r1:X25519:ffdhe2048
CipherString = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3
